# Copie para .env.local e preencha. Nunca faça commit de .env.local.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# --- Supabase (Project Settings → API Keys) ---
# URL do projeto, ex.: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave publicável (sb_publishable_...). Pública por natureza; os dados são protegidos pelo RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...). SÓ no servidor: na Vercel, marque como "Sensitive".
# Usada para cadastrar membros e registrar notificações.
SUPABASE_SECRET_KEY=

# --- Site ---
# Endereço público, usado nos links dos e-mails. Sem ela, usa o endereço do pedido.
# NEXT_PUBLIC_SITE_URL=https://app.nexiavs.com.br
# Página de agendamento da reunião com o Victor (Google Agenda, Calendly...). Precisa começar com https://
# Sem ela, o membro vê "a equipe vai falar com você para agendar".
LINK_AGENDAMENTO=

# --- E-mail (Resend) ---
# Sem estas duas, a plataforma funciona e mostra o link do convite para a equipe mandar pelo WhatsApp.
RESEND_API_KEY=
# Remetente num domínio verificado no Resend.
EMAIL_REMETENTE=NEXIA <acesso@app.nexiavs.com.br>

# --- Próximos marcos (ainda não usadas) ---
# Anthropic, rascunho do plano pela IA. Marco 5.
# ANTHROPIC_API_KEY=
