# Copie para .env.local e preencha. Nunca faça commit de .env.local.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# Supabase → Project Settings → API (ou "Connect")
# URL do projeto, ex.: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave publicável (sb_publishable_...). A chave "anon" antiga também funciona.
# É pública por natureza; os dados são protegidos pelo RLS do banco.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional: endereço público do site, usado no link mágico.
# Sem ela, o app usa o endereço de onde o pedido veio.
# NEXT_PUBLIC_SITE_URL=https://nexia.ecossistemavs.com.br

# --- Próximos marcos (ainda não usadas) ---
# Chave secreta do Supabase (sb_secret_...), só no servidor. Marco 2.
# SUPABASE_SECRET_KEY=
# Resend, e-mails transacionais. Marco 7.
# RESEND_API_KEY=
# Anthropic, rascunho do plano pela IA. Marco 5.
# ANTHROPIC_API_KEY=
